---
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white mt-20">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-display text-xl mb-4">Baluchi Doch</h3>
        <p class="text-sm">Specializing in Custom Baluchi Dress Tailoring<br/>Based in Punjab, Pakistan</p>
      </div>
      <div>
        <h4 class="font-display text-lg mb-4">Contact</h4>
        <address class="not-italic text-sm">
          <p>Near Lahore, Punjab</p>
          <p>Email: info@baluchidoch.com</p>
          <p>Phone: +92 XXX XXXXXXX</p>
        </address>
      </div>
      <div>
        <h4 class="font-display text-lg mb-4">Quick Links</h4>
        <ul class="text-sm space-y-2">
          <li><a href="/about" class="hover:text-secondary transition-colors">About Us</a></li>
          <li><a href="/services" class="hover:text-secondary transition-colors">Services</a></li>
          <li><a href="/portfolio" class="hover:text-secondary transition-colors">Portfolio</a></li>
          <li><a href="/contact" class="hover:text-secondary transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/20 mt-8 pt-8 text-center text-sm">
      <p>&copy; {currentYear} Baluchi Doch. All rights reserved.</p>
    </div>
  </div>
</footer>