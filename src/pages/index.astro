---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    title: 'Custom Tailoring',
    description: 'Expert customization of traditional Baluchi dresses'
  },
  {
    title: 'Quality Craftsmanship',
    description: 'Meticulous attention to detail in every stitch'
  },
  {
    title: 'Traditional Designs',
    description: 'Authentic Baluchi patterns and styles'
  }
];

const services = [
  {
    title: 'Custom Dress Design',
    description: 'Transform your raw Baluchi dress with unique, personalized designs.',
    image: '/imgs/baluchi_doch (1).jpeg'
  },
  {
    title: 'Embroidery Work',
    description: 'Add intricate embroidery patterns that blend traditional motifs with contemporary designs.',
    image: '/imgs/baluchi_doch (2).jpeg'
  },
  {
    title: 'Alterations',
    description: 'Perfect the fit of your Baluchi dress with our expert alteration services.',
    image: '/imgs/baluchi_doch (3).jpeg'
  }
];

const portfolioItems = [
  {
    title: 'Traditional Design',
    image: '/imgs/baluchi_doch (1).jpeg'
  },
  {
    title: 'Modern Fusion',
    image: '/imgs/baluchi_doch (2).jpeg'
  },
  {
    title: 'Classic Style',
    image: '/imgs/baluchi_doch (3).jpeg'
  }
];

const steps = [
  {
    number: '01',
    title: 'Initial Contact',
    description: 'Reach out through our contact form'
  },
  {
    number: '02',
    title: 'Ship Your Dress',
    description: 'Send your dress to our workshop'
  },
  {
    number: '03',
    title: 'Customization',
    description: 'We transform your dress'
  }
];

const testimonials = [
  {
    name: 'Sarah A.',
    text: 'The attention to detail and craftsmanship is exceptional. My dress turned out better than I could have imagined!',
    location: 'Karachi'
  },
  {
    name: 'Amina R.',
    text: 'Professional service from start to finish. The customization perfectly matched my vision.',
    location: 'Islamabad'
  }
];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative h-[80vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/90 to-primary/70">
      <img src="/imgs/baluchi_doch (1).jpeg" alt="Baluchi Dress" class="w-full h-full object-cover mix-blend-overlay" />
    </div>
    <div class="container mx-auto px-4 relative text-white">
      <h1 class="font-display text-5xl md:text-6xl mb-6" data-aos="fade-up">
        Transform Your Baluchi Dress
      </h1>
      <p class="text-xl md:text-2xl mb-8 max-w-2xl" data-aos="fade-up" data-aos-delay="100">
        Expert customization services for traditional Baluchi dresses
      </p>
      <a 
        href="/contact" 
        class="inline-block bg-secondary hover:bg-accent text-white px-8 py-3 rounded-md transition-colors"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        Get Started
      </a>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl text-primary mb-8" data-aos="fade-up">About Us</h2>
        <p class="text-lg text-gray-700 mb-8" data-aos="fade-up" data-aos-delay="100">
          At Baluchi Doch, we are passionate about preserving and elevating the traditional art of Baluchi dress making. Our expert tailors bring generations of expertise to every piece we customize.
        </p>
        <a href="/about" class="inline-block text-secondary hover:text-accent transition-colors">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-3xl md:text-4xl text-primary text-center mb-12" data-aos="fade-up">Our Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service, index) => (
          <div 
            class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <img src={service.image} alt={service.title} class="w-full h-48 object-cover" />
            <div class="p-6">
              <h3 class="font-display text-xl text-primary mb-4">{service.title}</h3>
              <p class="text-gray-700">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/services" class="inline-block text-secondary hover:text-accent transition-colors">View All Services →</a>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-3xl md:text-4xl text-primary text-center mb-12" data-aos="fade-up">Our Portfolio</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {portfolioItems.map((item, index) => (
          <div 
            class="relative group overflow-hidden rounded-lg"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <img src={item.image} alt={item.title} class="w-full h-64 object-cover" />
            <div class="absolute inset-0 bg-primary/80 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <h3 class="text-white font-display text-xl">{item.title}</h3>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/portfolio" class="inline-block text-secondary hover:text-accent transition-colors">View Full Portfolio →</a>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-3xl md:text-4xl text-primary text-center mb-12" data-aos="fade-up">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {steps.map((step, index) => (
          <div 
            class="text-center"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-6 text-xl font-bold">
              {step.number}
            </div>
            <h3 class="font-display text-xl text-primary mb-4">{step.title}</h3>
            <p class="text-gray-700">{step.description}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/how-it-works" class="inline-block text-secondary hover:text-accent transition-colors">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-3xl md:text-4xl text-primary text-center mb-12" data-aos="fade-up">
        What Our Clients Say
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {testimonials.map((testimonial, index) => (
          <div 
            class="bg-white p-8 rounded-lg shadow-md"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <p class="text-gray-700 mb-4">"{testimonial.text}"</p>
            <div class="font-semibold">
              <p class="text-primary">{testimonial.name}</p>
              <p class="text-gray-500 text-sm">{testimonial.location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl text-primary mb-8" data-aos="fade-up">Ready to Get Started?</h2>
        <p class="text-lg text-gray-700 mb-8" data-aos="fade-up" data-aos-delay="100">
          Contact us today to transform your Baluchi dress into a masterpiece.
        </p>
        <a 
          href="/contact" 
          class="inline-block bg-secondary hover:bg-accent text-white px-8 py-3 rounded-md transition-colors"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>