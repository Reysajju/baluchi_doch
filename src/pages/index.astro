---
import Layout from '../layouts/Layout.astro';

const heroImages = [
  {
    url: '/hero1.jpg',
    title: 'Traditional Baluchi Elegance',
    description: 'Handcrafted with love and tradition'
  },
  {
    url: '/hero2.jpg',
    title: 'Modern Baluchi Fashion',
    description: 'Where tradition meets contemporary style'
  },
  {
    url: '/hero3.jpg',
    title: 'Timeless Beauty',
    description: 'Celebrating the art of Baluchi craftsmanship'
  }
];

const features = [
  {
    icon: '🎨',
    title: 'Custom Designs',
    description: 'Unique patterns and designs tailored to your preferences'
  },
  {
    icon: '✨',
    title: 'Quality Craftsmanship',
    description: 'Expert tailors with generations of experience'
  },
  {
    icon: '🌟',
    title: 'Traditional Expertise',
    description: 'Preserving authentic Baluchi dress-making techniques'
  },
  {
    icon: '⚡',
    title: 'Quick Turnaround',
    description: 'Efficient service without compromising quality'
  }
];

const steps = [
  {
    title: 'Ship Your Raw Dress',
    description: 'Send your raw Baluchi dress to our workshop in Punjab.',
    icon: '📦'
  },
  {
    title: 'Custom Design',
    description: 'Our expert tailors add unique, customized designs based on your preferences.',
    icon: '✂️'
  },
  {
    title: 'Quality Check',
    description: 'Each piece undergoes thorough quality inspection before shipping.',
    icon: '✅'
  },
  {
    title: 'Shipping Back',
    description: 'Your beautifully customized dress is carefully packaged and shipped back to you.',
    icon: '🚚'
  }
];

const testimonials = [
  {
    name: 'Sarah A.',
    text: 'The attention to detail and craftsmanship is exceptional. My dress turned out better than I could have imagined!',
    location: 'Karachi',
    image: '/testimonial1.jpg'
  },
  {
    name: 'Amina R.',
    text: 'Professional service from start to finish. The customization perfectly matched my vision.',
    location: 'Islamabad',
    image: '/testimonial2.jpg'
  }
];
---

<Layout title="Welcome">
  <main>
    <!-- Dynamic Hero Section -->
    <section class="relative h-screen overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-primary/90 to-secondary/90 z-10"></div>
      <div class="absolute inset-0 z-0">
        {heroImages.map((image, index) => (
          <img
            src={image.url}
            alt={image.title}
            class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 hero-image ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
          />
        ))}
      </div>
      <div class="relative z-20 h-full flex items-center justify-center">
        <div class="text-center text-white px-4 hero-content">
          <h1 class="font-display text-5xl md:text-7xl mb-6 opacity-0 translate-y-8 animate-fade-in-up">
            Elevate Your Baluchi Dress
          </h1>
          <p class="text-xl md:text-2xl mb-8 opacity-0 translate-y-8 animate-fade-in-up animation-delay-300">
            Specializing in Custom Baluchi Dress Tailoring | Based in Punjab, Pakistan
          </p>
          <a 
            href="/contact" 
            class="inline-block bg-white text-primary px-8 py-4 rounded-full text-lg hover:bg-gray-100 transition-all duration-300 hover:scale-105 opacity-0 translate-y-8 animate-fade-in-up animation-delay-600"
          >
            Get Started
          </a>
        </div>
      </div>
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 animate-bounce">
        <a href="#features" class="text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-display text-primary text-center mb-16" data-aos="fade-up">Why Choose Us</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {features.map((feature, index) => (
            <div 
              class="bg-white p-8 rounded-lg shadow-lg text-center transform hover:-translate-y-2 transition-all duration-300"
              data-aos="fade-up"
              data-aos-delay={index * 100}
            >
              <div class="text-4xl mb-4">{feature.icon}</div>
              <h3 class="font-display text-xl text-primary mb-4">{feature.title}</h3>
              <p class="text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="py-20">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-display text-primary text-center mb-16" data-aos="fade-up">Our Process</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {steps.map((step, index) => (
            <div 
              class="relative"
              data-aos="fade-right"
              data-aos-delay={index * 200}
            >
              <div class="bg-white p-8 rounded-lg shadow-lg text-center h-full">
                <div class="text-4xl mb-4">{step.icon}</div>
                <h3 class="font-display text-xl text-primary mb-4">{step.title}</h3>
                <p class="text-gray-600">{step.description}</p>
              </div>
              {index < steps.length - 1 && (
                <div class="hidden lg:block absolute top-1/2 -right-4 w-8 h-0.5 bg-primary"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-display text-primary text-center mb-16" data-aos="fade-up">What Our Clients Say</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {testimonials.map((testimonial, index) => (
            <div 
              class="bg-white p-8 rounded-lg shadow-lg"
              data-aos="fade-up"
              data-aos-delay={index * 200}
            >
              <div class="flex items-center mb-6">
                <img 
                  src={testimonial.image} 
                  alt={testimonial.name}
                  class="w-16 h-16 rounded-full object-cover mr-4"
                />
                <div>
                  <h3 class="font-display text-lg text-primary">{testimonial.name}</h3>
                  <p class="text-gray-600">{testimonial.location}</p>
                </div>
              </div>
              <p class="text-gray-700 italic">"{testimonial.text}"</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-primary">
      <div 
        class="container mx-auto px-4 text-center"
        data-aos="fade-up"
      >
        <h2 class="text-4xl font-display text-white mb-8">Ready to Transform Your Dress?</h2>
        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Let us help you create a unique and beautiful piece that celebrates the rich tradition of Baluchi craftsmanship.
        </p>
        <a 
          href="/contact" 
          class="inline-block bg-white text-primary px-8 py-4 rounded-full text-lg hover:bg-gray-100 transition-all duration-300 hover:scale-105"
        >
          Get Started Today
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 1s ease-out forwards;
  }
  
  .animation-delay-300 {
    animation-delay: 300ms;
  }
  
  .animation-delay-600 {
    animation-delay: 600ms;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
let currentImage = 0;
const images = document.querySelectorAll('.hero-image');
const titles = document.querySelectorAll('.hero-title');

function rotateImages() {
  images[currentImage].classList.remove('opacity-100');
  images[currentImage].classList.add('opacity-0');
  
  currentImage = (currentImage + 1) % images.length;
  
  images[currentImage].classList.remove('opacity-0');
  images[currentImage].classList.add('opacity-100');
}

setInterval(rotateImages, 5000);
</script>