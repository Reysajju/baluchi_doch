    title: 'Modern Baluchi Fashion',
    description: 'Where tradition meets contemporary style'
  },
  {
    url: '/imgs/baluchi_doch (3).jpeg',
    title: 'Timeless Beauty',
    description: 'Celebrating the art of Baluchi craftsmanship'
  },
  // Placeholders for the remaining 7 images - update URLs when available
  {
    url: '/imgs/baluchi_doch (4).jpeg',
    title: 'Contemporary Designs',
    description: 'Modern interpretations of traditional styles'
  },
  {
    url: '/imgs/baluchi_doch (5).jpeg',
    title: 'Elegant Craftsmanship',
    description: 'Attention to every detail'
  },
  {
    url: '/imgs/baluchi_doch (6).jpeg',
    title: 'Traditional Excellence',
    description: 'Preserving cultural heritage'
  },
  {
    url: '/imgs/baluchi_doch (7).jpeg',
    title: 'Artistic Expression',
    description: 'Where creativity meets tradition'
  },
  {
    url: '/imgs/baluchi_doch (8).jpeg',
    title: 'Cultural Heritage',
    description: 'Celebrating Baluchi artistry'
  },
  {
    url: '/imgs/baluchi_doch (9).jpeg',
    title: 'Modern Elegance',
    description: 'Contemporary Baluchi fashion'
  },
  {
