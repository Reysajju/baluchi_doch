---
import Layout from '../layouts/Layout.astro';

const portfolioItems = [
  {
    title: 'Traditional Baluchi Dress',
    description: 'Custom embroidery with traditional patterns',
    image: '/portfolio1.jpg'
  },
  {
    title: 'Modern Fusion Design',
    description: 'Contemporary take on classic Baluchi style',
    image: '/portfolio2.jpg'
  },
  // Add more portfolio items
];
---

<Layout title="Portfolio">
  <main class="container mx-auto px-4 py-20">
    <h1 class="font-display text-4xl text-primary text-center mb-12">Our Portfolio</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {portfolioItems.map(item => (
        <div class="bg-white rounded-lg overflow-hidden shadow-md">
          <img src={item.image} alt={item.title} class="w-full h-64 object-cover" />
          <div class="p-6">
            <h3 class="font-display text-xl text-primary mb-2">{item.title}</h3>
            <p class="text-gray-700">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>