---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Custom Dress Design',
    description: 'Transform your raw Baluchi dress with unique, personalized designs tailored to your preferences.',
    image: '/imgs/baluchi_doch (1).jpeg'
  },
  {
    title: 'Embroidery Work',
    description: 'Add intricate embroidery patterns that blend traditional motifs with contemporary designs.',
    image: '/imgs/baluchi_doch (2).jpeg'
  },
  {
    title: 'Alterations',
    description: 'Perfect the fit of your Baluchi dress with our expert alteration services.',
    image: '/imgs/baluchi_doch (3).jpeg'
  },
  {
    title: 'Design Consultation',
    description: 'Get professional guidance on design choices that will enhance your dress while maintaining its traditional essence.',
    image: '/imgs/baluchi_doch (1).jpeg'
  }
];
---

<Layout title="Our Services">
  <main>
    <!-- Hero Section -->
    <section class="relative h-[40vh]">
      <div class="absolute inset-0 bg-gradient-to-r from-primary/90 to-primary/70">
        <img src="/imgs/baluchi_doch (2).jpeg" alt="Services" class="w-full h-full object-cover mix-blend-overlay" />
      </div>
      <div class="container mx-auto px-4 h-full flex items-center relative">
        <h1 class="font-display text-4xl md:text-5xl text-white" data-aos="fade-up">Our Services</h1>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          {services.map((service, index) => (
            <div 
              class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300" 
              data-aos="fade-up"
              data-aos-delay={index * 100}
            >
              <div class="relative h-64">
                <img 
                  src={service.image} 
                  alt={service.title} 
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
              </div>
              <div class="p-8">
                <h3 class="font-display text-2xl text-primary mb-4">{service.title}</h3>
                <p class="text-gray-700 leading-relaxed">{service.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="bg-gray-50 py-20">
      <div class="container mx-auto px-4 text-center">
        <h2 class="font-display text-3xl text-primary mb-6" data-aos="fade-up">Ready to Transform Your Dress?</h2>
        <p class="text-gray-700 mb-8 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
          Contact us today to discuss your dress customization needs and bring your vision to life.
        </p>
        <a 
          href="/contact" 
          class="inline-block bg-secondary hover:bg-accent text-white px-8 py-3 rounded-md transition-colors"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Get Started
        </a>
      </div>
    </section>
  </main>
</Layout>